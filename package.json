{
  "name": "setlist",
  "productName": "FC Live Manager 2026",
  "version": "0.1.3",
  "description": "A self-managing library for Ableton Live projects: BPM, structure and light previews without opening Live.",
  "main": "src/main/main.js",
  "author": "Utsav",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --devtools",
    "build:ui": "vite build",
    "watch:ui": "vite build --watch",
    "build:icons": "node scripts/build-icons.js",
    "dist:win": "npm run build:ui && electron-builder --win",
    "dist:mac": "npm run build:ui && electron-builder --mac",
    "selftest": "node scripts/selftest.js",
    "index": "node scripts/index-cli.js",
    "verify": "node scripts/verify-set.js",
    "test:matching": "node scripts/test-matching.js",
    "test:previews": "node scripts/test-previews.js",
    "test:drop": "node scripts/test-drop.js",
    "check:renders": "node scripts/probe-refs.js",
    "check:lengths": "node scripts/crosscheck.js"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "chokidar": "^3.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lamejs": "^1.2.1",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.14",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "lightningcss-win32-x64-msvc": "^1.32.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.4"
  }
}
